<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!--
    The Dashboard's design system. Surfaces and text use WPF-UI's theme brushes (DynamicResource) so dark and light
    both work; everything specific to TelloGameRoom (status colours, spacing, card and text styles) is defined here.
  -->

  <!-- ===== Brand and status colours ===== -->
  <Color x:Key="BrandColor">#7C5CFF</Color>
  <Color x:Key="BrandAltColor">#EC4899</Color>
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
  <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource BrandColor}" Offset="0" />
    <GradientStop Color="{StaticResource BrandAltColor}" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="StatusInUseBrush" Color="#34D399" />
  <SolidColorBrush x:Key="StatusPausedBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="StatusFreeBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="StatusOfflineBrush" Color="#6B7280" />
  <SolidColorBrush x:Key="StatusLowBrush" Color="#F87171" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />

  <!-- ===== Spacing ===== -->
  <Thickness x:Key="PagePadding">28,20,28,24</Thickness>
  <Thickness x:Key="CardPadding">20</Thickness>
  <CornerRadius x:Key="CardRadius">14</CornerRadius>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- ===== Typography ===== -->
  <Style x:Key="TextBase" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0,12,0,5" />
  </Style>
  <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>

  <!-- ===== Card: rounded surface with a soft shadow ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000000" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Small round icon button used on machine cards ===== -->
  <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="17" />
  </Style>

  <!-- ===== Pill used for status chips and badges ===== -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <!-- ===== Sidebar navigation item ===== -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Margin="0,2">
            <Border x:Name="Root" CornerRadius="9" Background="Transparent" Padding="12,10">
              <ContentPresenter />
            </Border>
            <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrandBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Big preset button in the time dialog ===== -->
  <Style x:Key="PresetButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource BrandBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
