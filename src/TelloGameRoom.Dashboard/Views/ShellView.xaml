<UserControl x:Class="TelloGameRoom.Dashboard.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard"
             xmlns:vm="clr-namespace:TelloGameRoom.Dashboard.ViewModels"
             xmlns:v="clr-namespace:TelloGameRoom.Dashboard.Views">
  <UserControl.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <DataTemplate DataType="{x:Type vm:MachinesViewModel}">
      <v:MachinesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShiftsViewModel}">
      <v:ShiftsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
      <v:ReportsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
      <v:EmployeesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuditViewModel}">
      <v:AuditView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <v:SettingsView />
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,6,12,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="6,4,0,18">
          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandGradient}">
            <TextBlock Text="T" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TelloGameRoom" Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="14.5" />
            <TextBlock Text="{Binding RoleText}" Style="{StaticResource Muted}" FontSize="11.5" />
          </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}" ItemContainerStyle="{StaticResource NavItem}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Navigation">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="19" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Connection state: always visible -->
        <Border Grid.Row="2" Style="{StaticResource Chip}" Padding="12,8" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Muted}" FontSize="12.5" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===== Content ===== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Top bar -->
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="28,10,20,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Context.ShopName}" Style="{StaticResource TextBase}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Context.BranchName, StringFormat='  ·  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Visibility="{Binding HasSeveralBranches, Converter={StaticResource BoolVisible}, ConverterParameter=invert}" />
            <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" MinWidth="170" Margin="14,0,0,0"
                      Visibility="{Binding HasSeveralBranches, Converter={StaticResource BoolVisible}}" AutomationProperties.Name="Branch" />
            <Border Style="{StaticResource Chip}" Margin="16,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="People24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Context.OnDutyText}" Style="{StaticResource Muted}" FontSize="12.5" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandBrush}" VerticalAlignment="Center">
              <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding UserName}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,14,0" />
            <ui:Button Content="{l:Tr Shell_SignOut}" Icon="{ui:SymbolIcon SignOut24}" Command="{Binding SignOutCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <ui:InfoBar Grid.Row="1" Severity="Warning" IsOpen="True" IsClosable="False" Title="{l:Tr Conn_LostTitle}" Message="{l:Tr Conn_LostMessage}"
                  Margin="28,12,28,0" Visibility="{Binding IsReconnecting, Converter={StaticResource BoolVisible}}" />

      <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
  </Grid>
</UserControl>
