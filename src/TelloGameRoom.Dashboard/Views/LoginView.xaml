<UserControl x:Class="TelloGameRoom.Dashboard.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Width="420" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel>
      <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource BrandGradient}" HorizontalAlignment="Left">
        <TextBlock Text="T" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="{l:Tr Login_Title}" Style="{StaticResource PageTitle}" Margin="0,18,0,4" />
      <TextBlock Text="{l:Tr Login_Subtitle}" Style="{StaticResource Muted}" />

      <TextBlock Text="{l:Tr Login_Username}" Style="{StaticResource FieldLabel}" Margin="0,20,0,5" />
      <ui:TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />

      <TextBlock Text="{l:Tr Login_Password}" Style="{StaticResource FieldLabel}" />
      <ui:PasswordBox x:Name="PasswordBox" MaxLength="128" />

      <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />

      <ui:Button x:Name="SignInButton" Content="{l:Tr Login_Button}" Appearance="Primary" IsDefault="True" HorizontalAlignment="Stretch" Height="40"
                 Margin="0,24,0,0" Click="OnSignIn" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <TextBlock Text="{Binding ServerText}" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
        <ui:Button Content="{l:Tr Login_ChangeServer}" Appearance="Transparent" FontSize="12.5" Margin="6,0,0,0" Command="{Binding SwitchServerCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
