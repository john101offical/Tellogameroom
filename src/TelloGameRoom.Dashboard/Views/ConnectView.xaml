<UserControl x:Class="TelloGameRoom.Dashboard.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
    <l:InverseBoolConverter x:Key="Not" />
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Width="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel>
      <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource BrandGradient}" HorizontalAlignment="Left">
        <ui:SymbolIcon Symbol="PlugConnected24" FontSize="28" Foreground="White" />
      </Border>
      <TextBlock Text="{l:Tr Connect_Title}" Style="{StaticResource PageTitle}" Margin="0,18,0,4" />
      <TextBlock Text="{l:Tr Connect_Subtitle}" Style="{StaticResource Muted}" />

      <TextBlock Text="{l:Tr Connect_Server}" Style="{StaticResource FieldLabel}" Margin="0,20,0,5" />
      <ui:TextBox x:Name="ServerBox" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="203.0.113.5" />

      <TextBlock Text="{l:Tr Connect_Fingerprint}" Style="{StaticResource FieldLabel}" />
      <ui:TextBox Text="{Binding Fingerprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                  PlaceholderText="{l:Tr Connect_FingerprintHint}" />

      <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />

      <ui:Button Content="{l:Tr Connect_Button}" Appearance="Primary" IsDefault="True" HorizontalAlignment="Stretch" Height="40" Margin="0,24,0,0"
                 Command="{Binding ConnectCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
    </StackPanel>
  </Border>
</UserControl>
