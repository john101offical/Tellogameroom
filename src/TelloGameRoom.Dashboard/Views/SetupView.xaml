<UserControl x:Class="TelloGameRoom.Dashboard.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Width="500" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel>
      <TextBlock Text="{l:Tr Setup_Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{l:Tr Setup_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

      <!-- Step indicator -->
      <StackPanel Orientation="Horizontal" Margin="0,18,0,4">
        <Border Width="150" Height="4" CornerRadius="2" Background="{StaticResource BrandBrush}" Margin="0,0,8,0" />
        <Border Width="150" Height="4" CornerRadius="2">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                  <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
      </StackPanel>

      <!-- Step 1: the shop -->
      <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolVisible}}">
        <TextBlock Text="{l:Tr Setup_Step1}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
        <TextBlock Text="{l:Tr Setup_ShopName}" Style="{StaticResource FieldLabel}" />
        <ui:TextBox x:Name="ShopBox" Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
        <TextBlock Text="{l:Tr Setup_BranchName}" Style="{StaticResource FieldLabel}" />
        <ui:TextBox Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" PlaceholderText="{l:Tr Setup_BranchHint}" />
        <TextBlock Text="{l:Tr Setup_HourlyRate}" Style="{StaticResource FieldLabel}" />
        <ui:TextBox Text="{Binding HourlyRate, UpdateSourceTrigger=PropertyChanged}" MaxLength="14" PlaceholderText="5000" />
        <TextBlock Text="{l:Tr Setup_RateHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>

      <!-- Step 2: the owner account -->
      <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolVisible}}">
        <TextBlock Text="{l:Tr Setup_Step2}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
        <TextBlock Text="{l:Tr Setup_OwnerName}" Style="{StaticResource FieldLabel}" />
        <ui:TextBox x:Name="OwnerBox" Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
        <TextBlock Text="{l:Tr Login_Username}" Style="{StaticResource FieldLabel}" />
        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
        <TextBlock Text="{l:Tr Login_Password}" Style="{StaticResource FieldLabel}" />
        <ui:PasswordBox x:Name="PasswordBox" MaxLength="128" />
        <TextBlock Text="{l:Tr Setup_PasswordAgain}" Style="{StaticResource FieldLabel}" />
        <ui:PasswordBox x:Name="ConfirmBox" MaxLength="128" />
        <TextBlock Text="{l:Tr Setup_PasswordRule}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>

      <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />

      <Grid Margin="0,24,0,0">
        <ui:Button Content="{l:Tr Common_Back}" Command="{Binding BackCommand}" HorizontalAlignment="Left" MinWidth="96"
                   Visibility="{Binding IsStep2, Converter={StaticResource BoolVisible}}" />
        <ui:Button Content="{l:Tr Common_Next}" Appearance="Primary" HorizontalAlignment="Right" MinWidth="140" Height="38" Click="OnNext"
                   Visibility="{Binding IsStep1, Converter={StaticResource BoolVisible}}" />
        <ui:Button x:Name="FinishButton" Content="{l:Tr Setup_Finish}" Appearance="Primary" HorizontalAlignment="Right" MinWidth="180" Height="38" Click="OnFinish"
                   Visibility="{Binding IsStep2, Converter={StaticResource BoolVisible}}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
