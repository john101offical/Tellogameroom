<UserControl x:Class="TelloGameRoom.Dashboard.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{l:Tr Nav_Audit}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{l:Tr Audit_Hint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
      </StackPanel>
      <ui:Button Grid.Column="1" Content="{l:Tr Common_ExportCsv}" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportCommand}"
                 VerticalAlignment="Center" Visibility="{Binding CanExport, Converter={StaticResource BoolVisible}}" />
    </Grid>

    <ui:InfoBar Grid.Row="1" Severity="Error" IsOpen="True" IsClosable="False" Message="{Binding Error}" Margin="0,12,0,0"
                Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />

    <!-- Filters -->
    <WrapPanel Grid.Row="2" Margin="0,14,0,4">
      <ui:TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr Audit_Search}" Width="240" Margin="0,0,8,8"
                  Icon="{ui:SymbolIcon Search24}">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>
      <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label" Width="180" Margin="0,0,8,8" />
      <DatePicker SelectedDate="{Binding From}" Width="150" Margin="0,0,8,8" />
      <DatePicker SelectedDate="{Binding To}" Width="150" Margin="0,0,8,8" />
      <CheckBox Content="{l:Tr Audit_ThisBranch}" IsChecked="{Binding ThisBranchOnly}" Margin="4,0,12,8" VerticalAlignment="Center" />
      <ui:Button Content="{l:Tr Audit_Apply}" Appearance="Primary" Command="{Binding SearchNowCommand}" Margin="0,0,0,8" />
    </WrapPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
              SelectionMode="Single" CanUserResizeRows="False" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Tr Col_Time}" Binding="{Binding Time}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_Action}" Binding="{Binding Action}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_User}" Binding="{Binding User}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_Machine}" Binding="{Binding Machine}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_Details}" Binding="{Binding Details}" Width="2*" />
        <DataGridTextColumn Header="{l:Tr Common_Reason}" Binding="{Binding Reason}" Width="*" />
        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Text="{Binding PageText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
      <ui:Button Content="{l:Tr Audit_Previous}" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
      <ui:Button Content="{l:Tr Audit_Next}" Command="{Binding NextCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
