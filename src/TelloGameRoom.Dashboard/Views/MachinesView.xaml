<UserControl x:Class="TelloGameRoom.Dashboard.Views.MachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard"
             xmlns:c="clr-namespace:TelloGameRoom.Dashboard.Controls"
             x:Name="Root">
  <UserControl.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
    <l:StatusBrushConverter x:Key="StatusBrush" />
  </UserControl.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: title, summary and whole-room actions -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{l:Tr Nav_Machines}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Context.SummaryText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button Content="{l:Tr Machines_MessageAll}" Icon="{ui:SymbolIcon Chat24}" Command="{Binding MessageAllCommand}" Margin="0,0,8,0"
                   Visibility="{Binding CanMessage, Converter={StaticResource BoolVisible}}" />
        <ui:DropDownButton Content="{l:Tr Machines_AllMachines}" Icon="{ui:SymbolIcon Power24}" Margin="0,0,8,0"
                           Visibility="{Binding CanLock, Converter={StaticResource BoolVisible}}">
          <ui:DropDownButton.Flyout>
            <ContextMenu>
              <MenuItem Header="{l:Tr Machines_LockAll}" Command="{Binding LockAllCommand}" />
              <MenuItem Header="{l:Tr Machines_RestartAll}" Command="{Binding RestartAllCommand}" Visibility="{Binding CanPower, Converter={StaticResource BoolVisible}}" />
              <MenuItem Header="{l:Tr Machines_ShutdownAll}" Command="{Binding ShutdownAllCommand}" Visibility="{Binding CanPower, Converter={StaticResource BoolVisible}}" />
            </ContextMenu>
          </ui:DropDownButton.Flyout>
        </ui:DropDownButton>
        <ui:Button Content="{l:Tr Machines_AddMachine}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding PairNewCommand}"
                   Visibility="{Binding CanManage, Converter={StaticResource BoolVisible}}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <ui:InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
      <ui:InfoBar Severity="Success" IsOpen="True" IsClosable="False" Message="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}" />
    </StackPanel>

    <!-- Machine grid -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="-8,12,-8,0" Focusable="False">
      <ItemsControl ItemsSource="{Binding Context.Machines}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="232" Height="258" Margin="8" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding DataContext.PrimaryCommand, ElementName=Root}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Name}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="CardBorder" Style="{StaticResource Card}" Padding="16">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>

              <!-- Everything staff can do with a machine: right-click the card or press the ... button -->
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="{l:Tr Machines_Start}" Command="{Binding Tag.StartCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.IsFreeMachine, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Machines_AddTime}" Command="{Binding Tag.AddTimeCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.HasSession, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Machines_RemoveTime}" Command="{Binding Tag.RemoveTimeCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.HasSession, Converter={StaticResource BoolVisible}}" IsEnabled="{Binding Tag.CanRemoveTime}" />
                  <MenuItem Header="{l:Tr Machines_Pause}" Command="{Binding Tag.PauseCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.IsRunning, Converter={StaticResource BoolVisible}}" IsEnabled="{Binding Tag.CanPause}" />
                  <MenuItem Header="{l:Tr Machines_Resume}" Command="{Binding Tag.ResumeCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.IsPaused, Converter={StaticResource BoolVisible}}" IsEnabled="{Binding Tag.CanPause}" />
                  <MenuItem Header="{l:Tr Machines_Transfer}" Command="{Binding Tag.TransferCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.HasSession, Converter={StaticResource BoolVisible}}" IsEnabled="{Binding Tag.CanTransfer}" />
                  <MenuItem Header="{l:Tr Machines_Stop}" Command="{Binding Tag.StopCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.HasSession, Converter={StaticResource BoolVisible}}" IsEnabled="{Binding Tag.CanStop}" />
                  <MenuItem Header="{l:Tr Machines_CancelRefund}" Command="{Binding Tag.CancelCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding DataContext.HasSession, Converter={StaticResource BoolVisible}}" IsEnabled="{Binding Tag.CanCancel}" />
                  <Separator />
                  <MenuItem Header="{l:Tr Machines_SendMessage}" Command="{Binding Tag.MessageCommand}" CommandParameter="{Binding DataContext}" IsEnabled="{Binding Tag.CanMessage}" />
                  <MenuItem Header="{l:Tr Cmd_Lock}" Command="{Binding Tag.LockCommand}" CommandParameter="{Binding DataContext}" IsEnabled="{Binding Tag.CanLock}" />
                  <MenuItem Header="{l:Tr Cmd_Restart}" Command="{Binding Tag.RestartCommand}" CommandParameter="{Binding DataContext}" IsEnabled="{Binding Tag.CanPower}" />
                  <MenuItem Header="{l:Tr Cmd_Shutdown}" Command="{Binding Tag.ShutdownCommand}" CommandParameter="{Binding DataContext}" IsEnabled="{Binding Tag.CanPower}" />
                  <MenuItem Header="{l:Tr Machines_Screenshot}" Command="{Binding Tag.ScreenshotCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding Tag.CanScreenshot, Converter={StaticResource BoolVisible}}" />
                  <Separator Visibility="{Binding Tag.CanManage, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Machines_Rename}" Command="{Binding Tag.RenameCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding Tag.CanManage, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Machines_SetGroup}" Command="{Binding Tag.AssignGroupCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding Tag.CanManage, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Machines_ToggleEnabled}" Command="{Binding Tag.ToggleEnabledCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding Tag.CanManage, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Machines_RepairCode}" Command="{Binding Tag.RepairCodeCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding Tag.CanManage, Converter={StaticResource BoolVisible}}" />
                  <MenuItem Header="{l:Tr Common_Delete}" Command="{Binding Tag.DeleteCommand}" CommandParameter="{Binding DataContext}"
                            Visibility="{Binding Tag.CanManage, Converter={StaticResource BoolVisible}}" />
                </ContextMenu>
              </Button.ContextMenu>
              <Button.Tag>
                <Binding Path="DataContext" ElementName="Root" />
              </Button.Tag>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Name and status -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextBase}" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Top" Visibility="{Binding GroupName, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="{Binding GroupName}" Style="{StaticResource Muted}" FontSize="11.5" />
                  </Border>
                </Grid>

                <!-- In use: ring with the time left -->
                <Grid Grid.Row="1" Visibility="{Binding HasSession, Converter={StaticResource BoolVisible}}" Margin="0,8,0,4">
                  <Ellipse Width="118" Height="118" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="7" />
                  <c:RingArc Width="118" Height="118" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fraction="{Binding Fraction}">
                    <c:RingArc.Style>
                      <Style TargetType="c:RingArc">
                        <Setter Property="Stroke" Value="{StaticResource StatusInUseBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPaused}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource StatusPausedBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsLow}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource StatusLowBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </c:RingArc.Style>
                  </c:RingArc>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource TextBase}" FontFamily="{StaticResource MonoFont}" FontSize="22"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>

                <!-- Free: invitation to start -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding IsFreeMachine, Converter={StaticResource BoolVisible}}">
                  <ui:SymbolIcon Symbol="Play24" FontSize="38" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                  <TextBlock Text="{l:Tr Machines_Start}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding RateText}" Style="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Quick actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" ToolTip="{l:Tr Machines_AddTime}"
                             Command="{Binding DataContext.AddTimeCommand, ElementName=Root}" CommandParameter="{Binding}"
                             Visibility="{Binding HasSession, Converter={StaticResource BoolVisible}}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Pause24}" ToolTip="{l:Tr Machines_PauseResume}"
                             Command="{Binding DataContext.TogglePauseCommand, ElementName=Root}" CommandParameter="{Binding}"
                             Visibility="{Binding HasSession, Converter={StaticResource BoolVisible}}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Chat24}" ToolTip="{l:Tr Machines_SendMessage}"
                             Command="{Binding DataContext.MessageCommand, ElementName=Root}" CommandParameter="{Binding}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="{l:Tr Cmd_Restart}"
                             Command="{Binding DataContext.RestartCommand, ElementName=Root}" CommandParameter="{Binding}"
                             Visibility="{Binding DataContext.CanPower, ElementName=Root, Converter={StaticResource BoolVisible}}" />
                  <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="{l:Tr Machines_More}" Margin="0" Click="OnMore" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Empty state -->
    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmptyState" Visibility="Collapsed">
      <ui:SymbolIcon Symbol="Desktop24" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock Text="{l:Tr Machines_Empty}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
      <TextBlock Text="{l:Tr Machines_EmptyHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
