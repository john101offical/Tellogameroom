<UserControl x:Class="TelloGameRoom.Dashboard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980" HorizontalAlignment="Left">
      <TextBlock Text="{l:Tr Nav_Settings}" Style="{StaticResource PageTitle}" />
      <StackPanel Margin="0,12,0,0">
        <ui:InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
        <ui:InfoBar Severity="Success" IsOpen="True" IsClosable="False" Message="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}" />
      </StackPanel>

      <!-- This computer -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_ThisComputer}" Style="{StaticResource SectionTitle}" Margin="0" />
          <UniformGrid Columns="3" Margin="-6,0">
            <StackPanel Margin="6,0">
              <TextBlock Text="{l:Tr Settings_Language}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <TextBlock Text="{l:Tr Settings_Theme}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <TextBlock Text="{l:Tr Settings_Server}" Style="{StaticResource FieldLabel}" />
              <TextBlock Text="{Binding ServerText}" Style="{StaticResource Body}" Margin="0,6,0,0" />
              <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolVisible}}">

        <!-- Shop -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="{l:Tr Settings_Shop}" Style="{StaticResource SectionTitle}" Margin="0" />
            <UniformGrid Columns="2" Margin="-6,0">
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Setup_ShopName}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_ShopLanguage}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding ShopLanguage}" DisplayMemberPath="Label" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="{l:Tr Settings_Logo}" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="{l:Tr Settings_UploadLogo}" Icon="{ui:SymbolIcon Image24}" Command="{Binding UploadLogoCommand}" Margin="0,0,8,0" />
              <ui:Button Content="{l:Tr Settings_RemoveLogo}" Command="{Binding RemoveLogoCommand}" IsEnabled="{Binding HasLogo}" />
              <TextBlock Text="{l:Tr Settings_LogoHint}" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <ui:Button Content="{l:Tr Common_Save}" Appearance="Primary" MinWidth="120" HorizontalAlignment="Right" Margin="0,16,0,0" Command="{Binding SaveShopCommand}" />
          </StackPanel>
        </Border>

        <!-- Branch: pricing and behaviour -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:Tr Settings_Branch}" Style="{StaticResource SectionTitle}" Margin="0" />
              <ui:Button Grid.Column="1" Content="{l:Tr Settings_AddBranch}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddBranchCommand}" />
            </Grid>
            <UniformGrid Columns="3" Margin="-6,0">
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_BranchName}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_HourlyRate}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding HourlyRate, UpdateSourceTrigger=PropertyChanged}" MaxLength="14" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_WarningMinutes}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding WarningMinutes, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_CurrencyCode}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" CharacterCasing="Upper" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_CurrencySymbol}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_Decimals}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding DecimalOptions}" SelectedItem="{Binding Decimals}" DisplayMemberPath="Label" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_Rounding}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding RoundingOptions}" SelectedItem="{Binding Rounding}" DisplayMemberPath="Label" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_RoundingStep}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding RoundingStep, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />
              </StackPanel>
              <StackPanel Margin="6,0">
                <TextBlock Text="{l:Tr Settings_TimeZone}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="{l:Tr Settings_PriceHint}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,12,0,0" />

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <ui:Button Content="{l:Tr Settings_ChangePin}" Icon="{ui:SymbolIcon Key24}" Command="{Binding ChangePinCommand}" />
                <TextBlock Text="{Binding AdminPinStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="{l:Tr Common_Save}" Appearance="Primary" MinWidth="120" Command="{Binding SaveBranchCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Optional machine groups -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{l:Tr Settings_Groups}" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="{l:Tr Settings_GroupsHint}" Style="{StaticResource Muted}" FontSize="12.5" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="{l:Tr Common_Add}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddGroupCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{l:Tr Common_Edit}" Command="{Binding EditSelectedGroupCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{l:Tr Common_Delete}" Command="{Binding DeleteGroupCommand}" />
              </StackPanel>
            </Grid>
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="0,10,0,0" MaxHeight="200" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Group.Name}" Style="{StaticResource Body}" FontWeight="SemiBold" MinWidth="180" />
                    <TextBlock Text="{Binding RateText}" Style="{StaticResource Muted}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <!-- Backup -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding CanBackup, Converter={StaticResource BoolVisible}}">
          <StackPanel>
            <TextBlock Text="{l:Tr Settings_Backup}" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Text="{l:Tr Settings_BackupHint}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="{l:Tr Settings_BackupNow}" Icon="{ui:SymbolIcon CloudArrowDown24}" Command="{Binding BackupCommand}" Margin="0,0,8,0" />
              <ui:Button Content="{l:Tr Settings_Restore}" Icon="{ui:SymbolIcon CloudArrowUp24}" Appearance="Danger" Command="{Binding RestoreCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
