<ui:FluentWindow x:Class="TelloGameRoom.Dashboard.Views.ImageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:TelloGameRoom.Dashboard"
                 Width="1000" Height="640" MinWidth="480" MinHeight="320" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="Bar" ShowMinimize="False" />
    <Image x:Name="Picture" Grid.Row="1" Margin="16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
      <ui:Button Content="{l:Tr Common_SaveAs}" Click="OnSave" Margin="0,0,10,0" />
      <ui:Button Content="{l:Tr Common_Close}" Appearance="Primary" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
