<UserControl x:Class="TelloGameRoom.Dashboard.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="{l:Tr Nav_Shifts}" Style="{StaticResource PageTitle}" />
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <ui:InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
    </StackPanel>

    <!-- My shift -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <!-- Not clocked in -->
        <Grid Visibility="{Binding HasOpenShift, Converter={StaticResource BoolVisible}, ConverterParameter=invert}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Shifts_NotClockedIn}" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Text="{l:Tr Shifts_NotClockedInHint}" Style="{StaticResource Muted}" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="{l:Tr Shifts_Open}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Height="40" MinWidth="150"
                     Command="{Binding OpenCommand}" />
        </Grid>

        <!-- Clocked in: live reconciliation -->
        <Grid Visibility="{Binding HasOpenShift, Converter={StaticResource BoolVisible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{l:Tr Shifts_OnDuty}" Style="{StaticResource SectionTitle}" Margin="0" />
              <TextBlock Text="{Binding CurrentRow.Opened, StringFormat='  ·  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <UniformGrid Columns="4" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="{l:Tr Shifts_OpeningCash}" Style="{StaticResource Muted}" FontSize="12.5" />
                <TextBlock Text="{Binding CurrentRow.Opening}" Style="{StaticResource KpiValue}" FontSize="20" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{l:Tr Shifts_Sales}" Style="{StaticResource Muted}" FontSize="12.5" />
                <TextBlock Text="{Binding CurrentRow.Sales}" Style="{StaticResource KpiValue}" FontSize="20" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{l:Tr Shifts_Refunds}" Style="{StaticResource Muted}" FontSize="12.5" />
                <TextBlock Text="{Binding CurrentRow.Refunds}" Style="{StaticResource KpiValue}" FontSize="20" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{l:Tr Shifts_ExpectedCash}" Style="{StaticResource Muted}" FontSize="12.5" />
                <TextBlock Text="{Binding CurrentRow.Expected}" Style="{StaticResource KpiValue}" FontSize="20" Foreground="{StaticResource BrandBrush}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
          <ui:Button Grid.Column="1" Content="{l:Tr Shifts_Close}" Icon="{ui:SymbolIcon Stop24}" Appearance="Primary" Height="40" MinWidth="150"
                     VerticalAlignment="Center" Command="{Binding CloseCommand}" />
        </Grid>
      </Grid>
    </Border>

    <!-- History toolbar -->
    <Grid Grid.Row="3" Margin="0,22,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{l:Tr Shifts_History}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button Content="{l:Tr Common_Refresh}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
        <ui:Button Content="{l:Tr Shifts_Print}" Icon="{ui:SymbolIcon Print24}" Command="{Binding PrintSelectedCommand}" Margin="0,0,8,0" />
        <ui:Button Content="{l:Tr Shifts_CloseSelected}" Command="{Binding CloseSelectedCommand}" Margin="0,0,8,0"
                   Visibility="{Binding CanViewAll, Converter={StaticResource BoolVisible}}" />
        <ui:Button Content="{l:Tr Common_ExportCsv}" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportCommand}"
                   Visibility="{Binding CanExport, Converter={StaticResource BoolVisible}}" />
      </StackPanel>
    </Grid>

    <DataGrid Grid.Row="4" ItemsSource="{Binding Shifts}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Tr Col_Employee}" Binding="{Binding Employee}" Width="*" />
        <DataGridTextColumn Header="{l:Tr Col_Opened}" Binding="{Binding Opened}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_Closed}" Binding="{Binding Closed}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Shifts_OpeningCash}" Binding="{Binding Opening}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Shifts_Sales}" Binding="{Binding Sales}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Shifts_Refunds}" Binding="{Binding Refunds}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Shifts_ExpectedCash}" Binding="{Binding Expected}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Shifts_CountedCash}" Binding="{Binding Counted}" Width="Auto" />
        <DataGridTemplateColumn Header="{l:Tr Shifts_Difference}" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Difference}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsShort}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsOver}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
