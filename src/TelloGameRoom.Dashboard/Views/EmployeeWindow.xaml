<ui:FluentWindow x:Class="TelloGameRoom.Dashboard.Views.EmployeeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:TelloGameRoom.Dashboard"
                 Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
  <ui:FluentWindow.Resources>
    <l:BoolVisibilityConverter x:Key="BoolVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
    <l:InverseBoolConverter x:Key="Not" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
    <StackPanel Grid.Row="1" Margin="24,0,24,24">
      <TextBlock Text="{l:Tr Employees_DisplayName}" Style="{StaticResource FieldLabel}" />
      <ui:TextBox x:Name="NameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />

      <TextBlock Text="{l:Tr Login_Username}" Style="{StaticResource FieldLabel}" />
      <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" IsEnabled="{Binding IsNew}" />

      <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolVisible}}">
        <TextBlock Text="{l:Tr Login_Password}" Style="{StaticResource FieldLabel}" />
        <ui:PasswordBox x:Name="PasswordBox" MaxLength="128" />
        <TextBlock Text="{l:Tr Setup_PasswordRule}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>

      <TextBlock Text="{l:Tr Employees_Branches}" Style="{StaticResource FieldLabel}" />
      <ItemsControl ItemsSource="{Binding Branches}" IsEnabled="{Binding IsOwner, Converter={StaticResource Not}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <CheckBox Content="{l:Tr Employees_IsOwner}" IsChecked="{Binding IsOwner}" Margin="0,14,0,0" />
      <TextBlock Text="{l:Tr Employees_IsOwnerHint}" Style="{StaticResource Muted}" FontSize="12" Margin="28,0,0,0" />
      <CheckBox Content="{l:Tr Employees_ActiveToggle}" IsChecked="{Binding IsActive}" Margin="0,10,0,0"
                Visibility="{Binding IsNew, Converter={StaticResource BoolVisible}, ConverterParameter=invert}" />

      <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <ui:Button Content="{l:Tr Common_Cancel}" IsCancel="True" Margin="0,0,10,0" MinWidth="96" />
        <ui:Button x:Name="SaveButton" Content="{l:Tr Common_Save}" Appearance="Primary" IsDefault="True" MinWidth="120" Click="OnSave" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
