<UserControl x:Class="TelloGameRoom.Dashboard.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:TelloGameRoom.Dashboard">
  <UserControl.Resources>
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{l:Tr Nav_Employees}" Style="{StaticResource PageTitle}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button Content="{l:Tr Common_Edit}" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditCommand}" Margin="0,0,8,0" />
        <ui:Button Content="{l:Tr Employees_ResetPassword}" Icon="{ui:SymbolIcon Key24}" Command="{Binding ResetPasswordCommand}" Margin="0,0,8,0" />
        <ui:Button Content="{l:Tr Employees_ToggleActive}" Command="{Binding ToggleActiveCommand}" Margin="0,0,8,0" />
        <ui:Button Content="{l:Tr Employees_Add}" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Primary" Command="{Binding AddCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <ui:InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
      <ui:InfoBar Severity="Success" IsOpen="True" IsClosable="False" Message="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}" />
    </StackPanel>

    <DataGrid Grid.Row="2" Margin="0,12,16,0" ItemsSource="{Binding Employees}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" CanUserResizeRows="False" GridLinesVisibility="Horizontal">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Tr Employees_DisplayName}" Binding="{Binding Employee.DisplayName}" Width="*" />
        <DataGridTextColumn Header="{l:Tr Login_Username}" Binding="{Binding Employee.Username}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_Role}" Binding="{Binding RoleText}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Col_Status}" Binding="{Binding StatusText}" Width="Auto" />
        <DataGridTextColumn Header="{l:Tr Employees_Branches}" Binding="{Binding Branches}" Width="*" />
        <DataGridTextColumn Header="{l:Tr Col_LastLogin}" Binding="{Binding LastLogin}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- What employees may do -->
    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="0,12,0,0" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="{l:Tr Employees_Permissions}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
        <TextBlock Text="{l:Tr Employees_PermissionsHint}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Permissions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:ToggleSwitch Content="{Binding Label}" IsChecked="{Binding Allowed}" Margin="0,5" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
