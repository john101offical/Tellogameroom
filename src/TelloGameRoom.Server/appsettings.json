{
  "Storage": {
    "DataDirectory": "data"
  },
  "Jwt": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "AuthRateLimitPerMinute": 20,
    "TrustedProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
