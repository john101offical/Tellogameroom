<Window x:Class="TelloGameRoom.Machine.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TelloGameRoom.Machine"
        Title="TelloGameRoom notification" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
  </Window.Resources>
  <StackPanel Margin="24" Width="560">
    <!-- Time-running-out warning -->
    <Border Style="{StaticResource Card}" Padding="24" BorderBrush="{StaticResource WarningBrush}" BorderThickness="2" Margin="0,0,0,12"
            Visibility="{Binding WarningText, Converter={StaticResource NotEmpty}}">
      <StackPanel>
        <TextBlock Text="{l:Tr Warn_Title}" Style="{StaticResource TitleText}" Foreground="{StaticResource WarningBrush}" FontSize="22" />
        <TextBlock Text="{Binding WarningText}" Style="{StaticResource BodyText}" Margin="0,6,0,16" />
        <Button Content="{l:Tr Warn_Dismiss}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding DismissWarningCommand}" />
      </StackPanel>
    </Border>
    <!-- Message from staff -->
    <Border Style="{StaticResource Card}" Padding="24" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
            Visibility="{Binding MessageText, Converter={StaticResource NotEmpty}}">
      <StackPanel>
        <TextBlock Text="{l:Tr Msg_FromStaff}" Style="{StaticResource LabelText}" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="{Binding MessageText}" Style="{StaticResource TitleText}" FontSize="22" />
        <Button Content="{l:Tr Msg_Dismiss}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,16,0,0"
                Command="{Binding DismissMessageCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
