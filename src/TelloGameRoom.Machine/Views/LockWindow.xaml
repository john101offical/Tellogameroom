<Window x:Class="TelloGameRoom.Machine.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TelloGameRoom.Machine"
        Title="TelloGameRoom"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="{StaticResource LockBackground}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <l:EnumVisibilityConverter x:Key="ScreenVisible" />
    <l:NotEmptyVisibilityConverter x:Key="NotEmpty" />
    <l:NullVisibilityConverter x:Key="WhenNull" />
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
  </Window.Resources>

  <!-- The window spans every monitor; PrimaryArea is sized in code to the primary screen so content is centred there. -->
  <Grid>
    <Grid x:Name="PrimaryArea" HorizontalAlignment="Left" VerticalAlignment="Top">

      <!-- Soft glow behind the brand -->
      <Ellipse Width="720" Height="720" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-160,0,0" Opacity="0.22" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
            <GradientStop Color="#007C5CFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- ===== Locked / Paused / Rejected ===== -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900"
                  Visibility="{Binding Screen, Converter={StaticResource ScreenVisible}, ConverterParameter='Locked,Paused,Rejected'}">
        <Grid Width="132" Height="132" HorizontalAlignment="Center" Margin="0,0,0,28">
          <Border CornerRadius="34" Background="{StaticResource AccentGradient}"
                  Visibility="{Binding Logo, Converter={StaticResource WhenNull}}">
            <TextBlock Text="{Binding Monogram}" FontSize="68" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding Logo, Converter={StaticResource NotEmpty}}" />
        </Grid>

        <TextBlock Text="{Binding ShopName}" Style="{StaticResource DisplayText}" TextAlignment="Center" />

        <Border HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,7" CornerRadius="18"
                Background="{StaticResource SurfaceHighBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
          <TextBlock Text="{Binding MachineName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" FontSize="18" />
        </Border>

        <!-- Locked -->
        <TextBlock Text="{l:Tr Lock_PayAtCounter}" Style="{StaticResource TitleText}" Foreground="{StaticResource MutedBrush}"
                   FontWeight="Normal" TextAlignment="Center" Margin="0,44,0,0"
                   Visibility="{Binding Screen, Converter={StaticResource ScreenVisible}, ConverterParameter='Locked'}" />

        <!-- Paused -->
        <StackPanel Margin="0,40,0,0" Visibility="{Binding Screen, Converter={StaticResource ScreenVisible}, ConverterParameter='Paused'}">
          <TextBlock Text="{l:Tr Lock_Paused}" Style="{StaticResource TitleText}" Foreground="{StaticResource WarningBrush}" TextAlignment="Center" />
          <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource MonoFont}" FontSize="72" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,10,0,6" />
          <TextBlock Text="{l:Tr Lock_PausedHint}" Style="{StaticResource MutedText}" TextAlignment="Center" />
        </StackPanel>

        <!-- Rejected -->
        <StackPanel Margin="0,40,0,0" Visibility="{Binding Screen, Converter={StaticResource ScreenVisible}, ConverterParameter='Rejected'}">
          <TextBlock Text="{l:Tr Lock_NotRegistered}" Style="{StaticResource TitleText}" Foreground="{StaticResource DangerBrush}" TextAlignment="Center" />
          <TextBlock Text="{l:Tr Lock_NotRegisteredHint}" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,20" />
          <Button Content="{l:Tr Pair_Button}" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Command="{Binding PairAgainCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- ===== Pairing ===== -->
      <Border Style="{StaticResource Card}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
              Visibility="{Binding Screen, Converter={StaticResource ScreenVisible}, ConverterParameter='Pairing'}">
        <StackPanel>
          <TextBlock Text="{l:Tr Pair_Title}" Style="{StaticResource TitleText}" />
          <TextBlock Text="{l:Tr Pair_Subtitle}" Style="{StaticResource MutedText}" Margin="0,6,0,24" />

          <TextBlock Text="{l:Tr Pair_Server}" Style="{StaticResource LabelText}" />
          <TextBox x:Name="ServerBox" Text="{Binding PairServer, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr Pair_ServerHint}" />

          <TextBlock Text="{l:Tr Pair_Code}" Style="{StaticResource LabelText}" Margin="0,18,0,6" />
          <TextBox x:Name="CodeBox" Text="{Binding PairCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                   FontSize="26" CharacterCasing="Upper" MaxLength="12" />

          <TextBlock Text="{l:Tr Pair_Fingerprint}" Style="{StaticResource LabelText}" Margin="0,18,0,6" />
          <TextBox Text="{Binding PairFingerprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   ToolTip="{l:Tr Pair_FingerprintHint}" />

          <TextBlock Text="{Binding PairError}" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" Margin="0,16,0,0"
                     Visibility="{Binding PairError, Converter={StaticResource NotEmpty}}" />

          <Button Content="{l:Tr Pair_Button}" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" IsDefault="True"
                  Command="{Binding PairCommand}" />
        </StackPanel>
      </Border>

      <!-- ===== Message from staff (shown on top of any lock state) ===== -->
      <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,48,0,0" MaxWidth="820" Padding="26,18" CornerRadius="18"
              Background="{StaticResource SurfaceHighBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
              Visibility="{Binding MessageText, Converter={StaticResource NotEmpty}}">
        <StackPanel>
          <TextBlock Text="{l:Tr Msg_FromStaff}" Style="{StaticResource LabelText}" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="{Binding MessageText}" Style="{StaticResource TitleText}" />
        </StackPanel>
      </Border>

      <!-- ===== Footer: clock and connection ===== -->
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="48,0,0,40">
        <TextBlock Text="{Binding ClockText}" Style="{StaticResource BaseText}" FontSize="40" FontWeight="Light" />
        <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,48,44">
        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding LinkStatus}" Value="Connected">
                  <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Text="{Binding BranchName, StringFormat='  ·  {0}'}" Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center"
                   Visibility="{Binding BranchName, Converter={StaticResource NotEmpty}}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
