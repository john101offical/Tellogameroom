<Window x:Class="TelloGameRoom.Machine.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TelloGameRoom.Machine"
        Title="{l:Tr Pin_Title}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
  <Border Style="{StaticResource Card}" Width="420" Margin="40">
    <StackPanel>
      <TextBlock Text="{l:Tr Pin_Title}" Style="{StaticResource TitleText}" />
      <TextBlock Text="{l:Tr Pin_Prompt}" Style="{StaticResource MutedText}" Margin="0,6,0,20" />
      <PasswordBox x:Name="PinBox" MaxLength="12" FontSize="24" />
      <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button Content="{l:Tr Pin_Cancel}" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="{l:Tr Pin_Confirm}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
