# The public address of this server: its IPv4 address, or a host name if you have one.
TELLO_ADDRESS=203.0.113.5

# Caddyfile.ip     - no domain name: self-signed certificate from deploy/caddy/make-cert.sh; clients pin its fingerprint.
# Caddyfile.domain - you have a (free) host name: automatic Let's Encrypt certificate, nothing to pin.
TELLO_CADDYFILE=Caddyfile.ip

# Time zone of the server's log timestamps. Report days use each branch's own time zone setting.
TZ=America/Bogota
