# For a server reached by IP address only (no domain name).
#
# Public certificate authorities such as Let's Encrypt do not issue ordinary certificates for bare IP addresses, so
# this uses a self-signed certificate made by make-cert.sh. Traffic is fully encrypted. The Dashboard and Machine
# apps "pin" the certificate's fingerprint, which is how they know they are talking to *your* server:
#
#   sh deploy/caddy/make-cert.sh
#
# prints the fingerprint. Type it once on each client (or pass it to the installer with /FINGERPRINT=...).

{
	# Clients that connect by IP address send no server name in the TLS handshake; serve this site's certificate anyway.
	default_sni {$TELLO_ADDRESS}
}

https://{$TELLO_ADDRESS} {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
	encode zstd gzip

	# WebSockets (SignalR) and REST both go to the server.
	reverse_proxy server:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Plain HTTP only redirects to HTTPS.
http://{$TELLO_ADDRESS} {
	redir https://{$TELLO_ADDRESS}{uri} permanent
}
